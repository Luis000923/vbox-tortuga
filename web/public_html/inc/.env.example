# =============================================================================
# Copia este archivo a  .env  y rellena los valores reales.
# NUNCA subas el .env real a un repositorio publico.
# En Hostinger, coloca la carpeta config/ FUERA de public_html.
# =============================================================================

# --- Base de datos (hPanel > Bases de datos MySQL) ---
DB_HOST=localhost
DB_NAME=uXXXX_tortuga
DB_USER=uXXXX_tortuga
DB_PASS=cambia_esta_password

# --- Clave del API que usa el script PowerShell ---
# Genera la clave en claro (esto lo pones en el script .ps1, en $ApiKey):
#   php -r "echo bin2hex(random_bytes(24)).PHP_EOL;"
# Genera el HASH de esa clave y ponlo aqui (el servidor solo guarda el hash):
#   php -r "echo hash('sha256','LA_CLAVE_EN_CLARO').PHP_EOL;"
API_KEY_HASH=pon_aqui_el_sha256_de_tu_clave

# --- Secreto para el cron que regenera el cache ---
#   php -r "echo bin2hex(random_bytes(16)).PHP_EOL;"
CRON_SECRET=pon_aqui_un_secreto_para_el_cron

# --- Entorno ---
# production = oculta errores al usuario. development = los muestra.
APP_ENV=production
